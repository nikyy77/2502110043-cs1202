class Machine:                          # The family drawing
    def __init__(self, tag):
        self.tag = tag
        self.running = False
        self.hours = 0

    def start(self): 
        self.running = True; return f"{self.tag} started"
    
    def stop(self):  
        self.running = False; return f"{self.tag} stopped"
    
    def status(self): 
        return f"{self.tag} running={self.running}"


class Lathe(Machine):                   # A variant: IS-A Machine
    def __init__(self, tag, max_rpm=2000):
        super().__init__(tag)           # Build the shared parts FIRST!
        self.max_rpm = max_rpm          # Then add what is ours alone
        self.parts = 0

    def make_part(self):                # Machining: Lathes do this
        if not self.running: 
            return "REFUSED: not running"
        self.parts += 1
        return f"{self.tag} made part #{self.parts}"

    def status(self):                   # OVERRIDE: our own version
        return super().status() + f" | {self.parts} parts"


