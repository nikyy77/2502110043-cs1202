# 1. BEST: Line-by-line iteration (Memory-safe for files of any size)
with open("data.txt", "r") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue  # Skip blank lines
        # Process line...

# 2. f.readlines(): Reads into a list of strings (Use only for small files)
# 3. f.read(): Reads entire file into one giant string (Use only for small files)
# Step 1: Initialize/Overwrite 5 records
with open("report.txt", "w") as f:
    for i in range(1, 6):
        f.write(f"Record {i}\n")

# Step 2: Append 6th record safely
with open("report.txt", "a") as f:
    f.write("Record 6\n")
